{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noulxp:0.2:conformance-case",
  "title": "One line of conformance.jsonl",
  "description": "A request and what the model's own code answered: the probability of every option of every question, or that it refused the request. SPEC.md section 9.",
  "type": "object",
  "required": ["id", "request"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}},
    "request": {
      "type": "object",
      "required": ["questions"],
      "properties": {"state": true, "questions": {"type": "object", "minProperties": 1}}
    },
    "expected": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["type", "probabilities"],
        "properties": {
          "type": {"enum": ["choice", "score", "noul"]},
          "probabilities": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["message"],
      "properties": {"type": {"type": "string"}, "message": {"type": "string"}}
    }
  },
  "oneOf": [
    {"required": ["expected"], "not": {"required": ["error"]}},
    {"required": ["error"], "not": {"required": ["expected"]}}
  ]
}
