{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noulxp:0.2:models",
  "title": "Discovery answer",
  "description": "What GET /v1/models returns: the models a server holds. SPEC.md section 11.3.",
  "type": "object",
  "required": ["object", "data"],
  "properties": {
    "object": {"const": "list"},
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "object", "standard", "profile", "question_types", "limits"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "object": {"const": "model"},
          "standard": {"type": "string", "pattern": "^(noulxp|odxp)/[0-9]+\\.[0-9]+$"},
          "profile": {"enum": ["encoder-markers", "causal-letters"]},
          "question_types": {
            "type": "array",
            "items": {"enum": ["choice", "score", "noul"]},
            "uniqueItems": true
          },
          "limits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
          "conformance": {
            "description": "The server's own conformance check, when it ran one; null otherwise.",
            "type": ["object", "null"],
            "properties": {
              "compatible": {"type": "boolean"},
              "cases": {"type": "integer"},
              "cases_passed": {"type": "integer"},
              "max_abs_dp": {"type": "number"},
              "decisions_equal": {"type": "string"},
              "device": {"type": ["string", "null"]}
            }
          },
          "calibration": {
            "description": "The calibration.json the server answers with in place of the package's (SPEC.md 7.1); null when it answers with the package's.",
            "type": ["object", "null"],
            "required": ["sha256"],
            "properties": {
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "temperature": {"type": ["object", "null"]}
            }
          }
        }
      }
    }
  }
}
