{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noulxp:0.2:manifest",
  "title": "NoulXP package manifest (noulxp.json)",
  "description": "The root of a NoulXP package: which standard and profile it follows and every file it carries, each with its SHA-256. SPEC.md section 4.",
  "type": "object",
  "required": ["standard", "name", "profile", "weights", "tokenizer", "calibration", "limits"],
  "properties": {
    "standard": {"enum": ["noulxp/0.1", "noulxp/0.2", "odxp/0.1", "odxp/0.2"]},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "profile": {"enum": ["encoder-markers", "causal-letters"]},
    "weights": {"$ref": "#/$defs/weights"},
    "tokenizer": {"$ref": "#/$defs/file"},
    "template": {"$ref": "#/$defs/file"},
    "prompt": {"$ref": "#/$defs/file"},
    "calibration": {"$ref": "#/$defs/file"},
    "answers": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "object",
          "propertyNames": {"enum": ["choice", "score", "noul"]},
          "additionalProperties": {"enum": ["max-probability", "entropy", "typesafe", "typesafe-ordinal", "none"]}
        }
      }
    },
    "limits": {
      "type": "object",
      "required": ["max_tokens", "max_options"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_options": {"type": "integer", "minimum": 2},
        "max_levels": {"type": "integer", "minimum": 2},
        "max_option_tokens": {"type": "integer", "minimum": 1},
        "max_questions": {"type": "integer", "minimum": 1}
      }
    },
    "conformance": {
      "allOf": [{"$ref": "#/$defs/file"}],
      "type": "object",
      "required": ["cases"],
      "properties": {
        "cases": {"type": "integer", "minimum": 1},
        "questions": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "tolerance": {
          "type": "object",
          "properties": {
            "max_abs_dp": {"const": 0.01},
            "tie_margin": {"const": 0.001}
          }
        },
        "generated_by": {"type": "object"}
      }
    },
    "source": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "encoder-markers"}}},
      "then": {
        "required": ["template"],
        "properties": {"weights": {"properties": {"format": {"const": "onnx"}}}}
      }
    },
    {
      "if": {"properties": {"profile": {"const": "causal-letters"}}},
      "then": {
        "required": ["prompt"],
        "properties": {"weights": {"properties": {"format": {"const": "gguf"}}}}
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\:][^\\\\:]*$",
      "not": {"pattern": "(^|/)\\.\\.(/|$)"}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "weights": {
      "allOf": [{"$ref": "#/$defs/file"}],
      "type": "object",
      "required": ["format"],
      "properties": {
        "format": {"enum": ["onnx", "gguf"]},
        "opset": {"type": "integer", "minimum": 17},
        "data": {"type": "array", "items": {"$ref": "#/$defs/file"}}
      }
    }
  }
}
