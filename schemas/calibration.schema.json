{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odxp:0.2:calibration",
  "title": "Calibration (calibration.json)",
  "description": "The temperature each question's logits are divided by before the softmax: the first matching by_option_count entry, else the type's temperature, else 1. SPEC.md section 7.",
  "type": "object",
  "required": ["standard", "temperature"],
  "properties": {
    "standard": {"enum": ["odxp/0.1", "odxp/0.2"]},
    "temperature": {
      "type": "object",
      "propertyNames": {"enum": ["choice", "score", "noul"]},
      "additionalProperties": {"$ref": "#/$defs/temperature"}
    },
    "by_option_count": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "min", "temperature"],
        "properties": {
          "type": {"enum": ["choice", "score", "noul"]},
          "min": {"type": "integer", "minimum": 1},
          "max": {"type": ["integer", "null"], "minimum": 1},
          "temperature": {"$ref": "#/$defs/temperature"}
        },
        "additionalProperties": false
      }
    },
    "source": {"description": "Where the values came from; informative only."}
  },
  "$defs": {
    "temperature": {"type": "number", "exclusiveMinimum": 0}
  }
}
