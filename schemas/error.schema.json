{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odxp:0.2:error",
  "title": "Error answer",
  "description": "The body of every non-2xx answer of the HTTP binding. SPEC.md section 11.4.",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["type", "message"],
      "properties": {
        "type": {
          "enum": [
            "invalid_request",
            "unauthorized",
            "not_found",
            "model_not_found",
            "request_too_large",
            "request_refused",
            "model_not_ready",
            "internal_error"
          ]
        },
        "message": {"type": "string"}
      }
    }
  }
}
